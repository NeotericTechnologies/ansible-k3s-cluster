[k3s_cluster:vars]
smoke_test_image=busybox:1.36.1

# Egress Gateway Tests:
egress_run_failover_test=true
egress_run_real_reboot_failover_test=false
dhcp_run_mutual_exclusion_test=false
kube_vip_lb_dhcp_enabled=false

# Local Test Inventory
# Purpose: Inventory for smoke tests against localhost or local VM
# Usage: ansible-playbook -i tests/ansible/inventories/local tests/ansible/smoke/smoke.yml

[k3s_servers]
k3s-server-01 ansible_host=192.168.50.119 ansible_user=ansible
k3s-server-02 ansible_host=192.168.50.121 ansible_user=ansible
k3s-server-03 ansible_host=192.168.50.120 ansible_user=ansible

[k3s_agents]
# k3s-agent-01 ansible_host=192.168.1.111 ansible_user=ansible

[k3s_cluster:children]
k3s_servers
k3s_agents

[k3s_cluster:vars]
control_plane_vip=192.168.50.8
api_port=6443
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
