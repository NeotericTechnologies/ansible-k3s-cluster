---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: synology-csi-controller
  namespace: {{ synology_csi_namespace }}
  labels:
    app.kubernetes.io/name: synology-csi-controller
    app.kubernetes.io/managed-by: ansible
spec:
  serviceName: synology-csi-controller
  replicas: {{ synology_csi_replicas | default(1) }}
  selector:
    matchLabels:
      app: synology-csi-controller
  template:
    metadata:
      labels:
        app: synology-csi-controller
    spec:
      serviceAccountName: csi-controller-sa
      containers:
        - name: csi-driver
          image: {{ synology_csi_controller_image }}
          args:
            - --nodeid=NotUsed
            - --endpoint=unix:///csi/csi.sock
            - --client-info=/etc/synology/client-info.yml
            - --log-level=info
          resources:
            requests:
              cpu: {{ synology_csi_driver_requests_cpu | default('25m') }}
              memory: {{ synology_csi_driver_requests_memory | default('32Mi') }}
            limits:
              cpu: {{ synology_csi_driver_limits_cpu | default('100m') }}
              memory: {{ synology_csi_driver_limits_memory | default('64Mi') }}
{% if synology_csi_liveness_probe_enabled %}
          # Complements the dsm-login-reconciler CronJob: this reacts fast to sustained DSM
          # outages, but can't see the one-shot-login-already-failed-then-network-recovered
          # case (this probe only reflects current reachability) — the CronJob still owns that.
          livenessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - >-
                  wget -q -O /dev/null --no-check-certificate --timeout=5
                  'https://{{ synology_csi_endpoint }}:{{ synology_csi_port }}/webapi/query.cgi?api=SYNO.API.Info&method=query&version=1'
            initialDelaySeconds: {{ synology_csi_liveness_probe_initial_delay }}
            periodSeconds: {{ synology_csi_liveness_probe_period }}
            timeoutSeconds: {{ synology_csi_liveness_probe_timeout }}
            failureThreshold: {{ synology_csi_liveness_probe_failure_threshold }}
{% endif %}
          volumeMounts:
            - name: socket-dir
              mountPath: /csi
            - name: client-info
              mountPath: /etc/synology
              readOnly: true
        - name: csi-provisioner
          image: registry.k8s.io/sig-storage/csi-provisioner:v3.6.3
          args:
            - --csi-address=/csi/csi.sock
            - --timeout=60s
            - --v=5
          resources:
            requests:
              cpu: {{ synology_csi_sidecar_requests_cpu | default('10m') }}
              memory: {{ synology_csi_sidecar_requests_memory | default('32Mi') }}
            limits:
              cpu: {{ synology_csi_sidecar_limits_cpu | default('50m') }}
              memory: {{ synology_csi_sidecar_limits_memory | default('64Mi') }}
          volumeMounts:
            - name: socket-dir
              mountPath: /csi
        - name: csi-attacher
          image: registry.k8s.io/sig-storage/csi-attacher:v4.4.3
          args:
            - --csi-address=/csi/csi.sock
            - --v=5
          resources:
            requests:
              cpu: {{ synology_csi_sidecar_requests_cpu | default('10m') }}
              memory: {{ synology_csi_sidecar_requests_memory | default('32Mi') }}
            limits:
              cpu: {{ synology_csi_sidecar_limits_cpu | default('50m') }}
              memory: {{ synology_csi_sidecar_limits_memory | default('64Mi') }}
          volumeMounts:
            - name: socket-dir
              mountPath: /csi
        - name: csi-resizer
          image: registry.k8s.io/sig-storage/csi-resizer:v1.9.3
          args:
            - --csi-address=/csi/csi.sock
            - --v=5
          resources:
            requests:
              cpu: {{ synology_csi_sidecar_requests_cpu | default('10m') }}
              memory: {{ synology_csi_sidecar_requests_memory | default('32Mi') }}
            limits:
              cpu: {{ synology_csi_sidecar_limits_cpu | default('50m') }}
              memory: {{ synology_csi_sidecar_limits_memory | default('64Mi') }}
          volumeMounts:
            - name: socket-dir
              mountPath: /csi
{% if synology_csi_snapshots_enabled %}
        - name: csi-snapshotter
          image: registry.k8s.io/sig-storage/csi-snapshotter:v6.3.3
          args:
            - --csi-address=/csi/csi.sock
            - --v=5
          resources:
            requests:
              cpu: {{ synology_csi_sidecar_requests_cpu | default('10m') }}
              memory: {{ synology_csi_sidecar_requests_memory | default('32Mi') }}
            limits:
              cpu: {{ synology_csi_sidecar_limits_cpu | default('50m') }}
              memory: {{ synology_csi_sidecar_limits_memory | default('64Mi') }}
          volumeMounts:
            - name: socket-dir
              mountPath: /csi
{% endif %}
      volumes:
        - name: socket-dir
          emptyDir: {}
        - name: client-info
          secret:
            secretName: client-info-secret
