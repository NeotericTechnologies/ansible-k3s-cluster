---
# ansible/roles/kube-vip/templates/kube-vip-rbac.yaml.j2
# Purpose: Consolidated RBAC for kube-vip DaemonSet + kube-vip-cloud-controller
# Reference: FR-008, FR-009, data-model.md §4, contracts/ansible-variable-contracts.md
# Single ClusterRole `kube-vip` is the union of prior kube-vip + kube-vip-cloud-controller
# ClusterRoles. Both ServiceAccounts bind to it via separate ClusterRoleBindings.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: kube-vip
  namespace: kube-system
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: kube-vip-cloud-controller
  namespace: kube-system
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: kube-vip-label-reconciler
  namespace: kube-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: kube-vip
rules:
  - apiGroups: [""]
    resources: ["services", "services/status", "nodes", "endpoints"]
    verbs: ["list", "get", "watch", "update", "patch"]
    # From a different iteration
    # verbs: ["list", "get", "watch", "update", "patch", "create"]
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["get", "list", "watch"]
    # From a different iteration
    # verbs: ["get", "list", "watch", "update", "patch"]
  - apiGroups: [""]
    resources: ["events"]
    verbs: ["create", "patch"]
  - apiGroups: ["discovery.k8s.io"]
    resources: ["endpointslices"]
    verbs: ["list", "get", "watch"]
  - apiGroups: ["coordination.k8s.io"]
    resources: ["leases"]
    verbs: ["list", "get", "watch", "update", "create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: kube-vip
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: kube-vip
subjects:
  - kind: ServiceAccount
    name: kube-vip
    namespace: kube-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: kube-vip-cloud-controller
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: kube-vip
subjects:
  - kind: ServiceAccount
    name: kube-vip-cloud-controller
    namespace: kube-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: kube-vip-label-reconciler
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: kube-vip
subjects:
  - kind: ServiceAccount
    name: kube-vip-label-reconciler
    namespace: kube-system
---
# Scoped separately from the shared `kube-vip` ClusterRole above so the actual kube-vip
# workload pods (bound to that ClusterRole too) don't gain pod-delete permission — only the
# reconciler needs it, to restart a kube-vip pod stuck holding a stale VIP after a failed
# leadership handoff, and to create short-lived privileged pods that directly verify/force-clear
# a stale VIP address at the network level on non-holder nodes (see
# kube-vip-label-reconciler-cronjob.yaml.j2).
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: kube-vip-label-reconciler-pods
  namespace: kube-system
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["list", "get", "create", "delete"]
  - apiGroups: [""]
    resources: ["pods/log"]
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: kube-vip-label-reconciler-pods
  namespace: kube-system
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: kube-vip-label-reconciler-pods
subjects:
  - kind: ServiceAccount
    name: kube-vip-label-reconciler
    namespace: kube-system
